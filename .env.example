# Janya Creations â€” Environment configuration
# Copy to .env.local and fill in real values. NEVER commit real credentials.

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service-role key (SERVER-ONLY â€” never in client code)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cashfree Payment Gateway (Hosted Checkout — Phase 1)
# CASHFREE_ENVIRONMENT: SANDBOX for development/test, PRODUCTION for live
# API version: 2026-01-01 (v6)
CASHFREE_ENVIRONMENT=SANDBOX
CASHFREE_CLIENT_ID=your_cashfree_app_id
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key

# PhonePe Payment Gateway (Standard Checkout) — fallback while Cashfree is new
# PHONEPE_ENV: SANDBOX for development/test, PRODUCTION for live
PHONEPE_CLIENT_ID=your_production_client_id
PHONEPE_CLIENT_SECRET=your_production_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
# Callback auth credentials configured on the PhonePe dashboard (Payment Settings)
PHONEPE_CALLBACK_USERNAME=your_phonepe_callback_username
PHONEPE_CALLBACK_PASSWORD=your_phonepe_callback_password

# Brevo transactional email (SERVER-ONLY)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=sender@yourdomain.com
BREVO_SENDER_NAME=Janya Creations

# Resend transactional email (SERVER-ONLY)
RESEND_API_KEY=your_resend_api_key
# Production sender — set ONLY after janyacreations.com is verified in Resend.
# Until then, the app uses the Resend sandbox sender (onboarding@resend.dev).
RESEND_FROM_EMAIL=Janya Creations <orders@janyacreations.com>
RESEND_REPLY_TO=janyacreations0@gmail.com

# Cron protection (SERVER-ONLY)
CRON_SECRET=your_cron_secret

# Public site URL (used in emails + payment callbacks)
NEXT_PUBLIC_SITE_URL=https://janyacreations.com
